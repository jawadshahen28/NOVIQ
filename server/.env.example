NODE_ENV=development
PORT=5010
MONGODB_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=<use-a-random-secret-at-least-32-characters-long>
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=noviq_admin_session

# Optional Cloudinary image uploads for admin product/category media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=noviq

# Optional one-time admin bootstrap values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
